{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.asteby.dev/metacore/genui-v2.schema.json",
  "title": "genui/v2",
  "description": "Contrato declarativo de UI genui/v2 (ADR 0001 del SDK). Fuente única del contrato: de aquí salen los tipos TS; el kernel Go copia este archivo (packages/genui/conformance/README.md). Las reglas que el esquema no expresa (límites globales, unicidad de id, gramática de $ref, enlaces seguros, destino de open) viven en el validador.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "blocks"
  ],
  "properties": {
    "version": {
      "const": "genui/v2"
    },
    "title": {
      "$ref": "#/$defs/label"
    },
    "i18n": {
      "enum": [
        "keys",
        "literal"
      ],
      "default": "literal"
    },
    "data": {
      "type": "object",
      "maxProperties": 8,
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/dataSource"
      }
    },
    "state": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
      },
      "description": "Estado local: solo escalares, listas de escalares y objetos de escalares (se valida en código)."
    },
    "overlays": {
      "type": "object",
      "maxProperties": 4,
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/overlay"
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/block"
      },
      "maxItems": 24,
      "minItems": 1
    }
  },
  "$defs": {
    "tone": {
      "enum": [
        "default",
        "muted",
        "info",
        "success",
        "warning",
        "danger"
      ],
      "description": "Vocabulario de tono compartido (Tone)."
    },
    "statFormat": {
      "enum": [
        "number",
        "currency",
        "percent",
        "compact",
        "date",
        "datetime",
        "relative_date"
      ],
      "description": "StatFormat (superconjunto de WidgetFormat)."
    },
    "fieldKind": {
      "enum": [
        "text",
        "textarea",
        "number",
        "integer",
        "email",
        "url",
        "phone",
        "date",
        "datetime",
        "time",
        "boolean",
        "switch",
        "select",
        "multiselect",
        "search"
      ],
      "description": "Tipos de campo (field.kind)."
    },
    "widgetSize": {
      "enum": [
        "sm",
        "md",
        "lg",
        "full"
      ]
    },
    "scalar": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ],
      "description": "Escalar; las cadenas no deben pasar de 2 000 caracteres (se valida en código)."
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
      "description": "Identificador único dentro del documento."
    },
    "key": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.]{0,63}$"
    },
    "bindingPath": {
      "type": "string",
      "pattern": "^(data|state|record|ctx)(\\.[A-Za-z_][A-Za-z0-9_]{0,63}|\\.[0-9]{1,3}){1,6}$",
      "description": "Ruta de vinculación; raíces cerradas data|state|record|ctx."
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$ref"
      ],
      "properties": {
        "$ref": {
          "$ref": "#/$defs/bindingPath"
        }
      },
      "description": "Vinculación {\"$ref\": \"<raíz>.<ruta>\"} en posiciones de valor."
    },
    "tref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$t"
      ],
      "properties": {
        "$t": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        "args": {
          "type": "object",
          "maxProperties": 8,
          "additionalProperties": {
            "anyOf": [
              {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              {
                "$ref": "#/$defs/ref"
              }
            ]
          }
        }
      },
      "description": "Clave i18n con argumentos insertados como texto."
    },
    "text": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 2000
        },
        {
          "$ref": "#/$defs/tref"
        },
        {
          "$ref": "#/$defs/ref"
        }
      ],
      "description": "Texto visible: literal, clave i18n o vinculación."
    },
    "label": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 160
        },
        {
          "$ref": "#/$defs/tref"
        },
        {
          "$ref": "#/$defs/ref"
        }
      ]
    },
    "value": {
      "anyOf": [
        {
          "$ref": "#/$defs/scalar"
        },
        {
          "$ref": "#/$defs/ref"
        }
      ],
      "description": "Valor: escalar o vinculación."
    },
    "link": {
      "type": "string",
      "maxLength": 2048,
      "description": "Ruta relativa de la app o http(s) literal; nunca $ref (se valida en código)."
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref"
      ],
      "minProperties": 2,
      "properties": {
        "ref": {
          "$ref": "#/$defs/bindingPath"
        },
        "equals": {
          "$ref": "#/$defs/scalar"
        },
        "in": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scalar"
          },
          "maxItems": 50
        },
        "not_in": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scalar"
          },
          "maxItems": 50
        },
        "empty": {
          "type": "boolean"
        }
      },
      "description": "Condición when (forma de VisibleWhen ampliada a cualquier raíz)."
    },
    "badge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label"
      ],
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 60
        },
        "tone": {
          "$ref": "#/$defs/tone"
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/label"
        },
        "value": {
          "$ref": "#/$defs/text"
        },
        "copy": {
          "type": "boolean"
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "label"
      ],
      "properties": {
        "value": {
          "type": "string",
          "maxLength": 160
        },
        "label": {
          "$ref": "#/$defs/label"
        }
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "format": {
          "$ref": "#/$defs/statFormat"
        }
      }
    },
    "row": {
      "type": "object",
      "maxProperties": 24,
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_.]{0,63}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/value"
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "$ref": "#/$defs/label"
        },
        "value": {
          "$ref": "#/$defs/text"
        },
        "hint": {
          "$ref": "#/$defs/label"
        },
        "trend": {
          "enum": [
            "up",
            "down",
            "flat"
          ]
        },
        "title": {
          "$ref": "#/$defs/label"
        },
        "url": {
          "$ref": "#/$defs/link"
        },
        "source": {
          "$ref": "#/$defs/label"
        },
        "date": {
          "type": "string",
          "maxLength": 160
        },
        "time": {
          "type": "string",
          "maxLength": 160
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "status": {
          "type": "string",
          "maxLength": 160
        },
        "tone": {
          "$ref": "#/$defs/tone"
        },
        "format": {
          "$ref": "#/$defs/statFormat"
        }
      }
    },
    "action": {
      "type": "object",
      "required": [
        "do"
      ],
      "properties": {
        "do": {
          "enum": [
            "navigate",
            "invoke",
            "submit",
            "open",
            "close",
            "set",
            "refresh",
            "emit"
          ]
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "variant": {
          "enum": [
            "primary",
            "secondary",
            "ghost",
            "danger"
          ]
        },
        "icon": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "confirm": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "$ref": "#/$defs/label"
            },
            "body": {
              "$ref": "#/$defs/text"
            },
            "tone": {
              "$ref": "#/$defs/tone"
            },
            "require_text": {
              "type": "string",
              "maxLength": 60
            }
          }
        },
        "when": {
          "$ref": "#/$defs/predicate"
        },
        "route": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "enum": [
                "record",
                "list",
                "page"
              ]
            },
            "model": {
              "$ref": "#/$defs/key"
            },
            "id": {
              "$ref": "#/$defs/value"
            },
            "filters": {
              "type": "object",
              "maxProperties": 8,
              "additionalProperties": {
                "$ref": "#/$defs/scalar"
              }
            },
            "key": {
              "$ref": "#/$defs/key"
            },
            "path": {
              "$ref": "#/$defs/link"
            }
          }
        },
        "action": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*){1,3}$",
          "description": "Acción del manifest <addon>.<Model>.<key> (invoke)."
        },
        "record": {
          "$ref": "#/$defs/value"
        },
        "params": {
          "type": "object",
          "maxProperties": 8,
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        },
        "values": {
          "type": "object",
          "maxProperties": 40,
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        },
        "form": {
          "$ref": "#/$defs/id"
        },
        "to": {
          "enum": [
            "invoke",
            "settings.write",
            "record.create",
            "record.update"
          ]
        },
        "model": {
          "$ref": "#/$defs/key"
        },
        "overlay": {
          "$ref": "#/$defs/id"
        },
        "path": {
          "type": "string",
          "pattern": "^state(\\.[A-Za-z_][A-Za-z0-9_]{0,63}){1,6}$"
        },
        "value": {
          "$ref": "#/$defs/scalar"
        },
        "source": {
          "$ref": "#/$defs/id"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,3}$"
        }
      },
      "additionalProperties": false,
      "description": "Acción declarativa {do, ...}; las reglas por verbo se validan en código."
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      },
      "maxItems": 6
    },
    "formField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label",
        "kind"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "kind": {
          "$ref": "#/$defs/fieldKind"
        },
        "required": {
          "type": "boolean"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/option"
          },
          "maxItems": 100
        },
        "value": {
          "$ref": "#/$defs/value"
        },
        "help": {
          "type": "string",
          "maxLength": 160
        },
        "placeholder": {
          "type": "string",
          "maxLength": 160
        },
        "depends_on": {
          "type": "string",
          "maxLength": 64
        },
        "visible_when": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "field": {
              "$ref": "#/$defs/key"
            },
            "equals": {
              "$ref": "#/$defs/scalar"
            },
            "in": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/scalar"
              },
              "maxItems": 50
            },
            "not_in": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/scalar"
              },
              "maxItems": 50
            },
            "empty": {
              "type": "boolean"
            }
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "min_length": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2000
            },
            "max_length": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2000
            },
            "pattern": {
              "type": "string",
              "maxLength": 200
            }
          }
        },
        "widget": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,31}$"
        },
        "section": {
          "type": "string",
          "maxLength": 64
        },
        "write_only": {
          "type": "boolean"
        }
      }
    },
    "dataSource": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 2,
      "properties": {
        "q": {
          "type": "string",
          "pattern": "^(t|m|mm|o|r|i|mi|me|x):[^\\s]{1,500}$",
          "description": "Token de lectura del query batch."
        },
        "plan": {
          "enum": [
            "model.list",
            "model.form",
            "dashboard.home"
          ]
        },
        "args": {
          "type": "object",
          "maxProperties": 8,
          "additionalProperties": {
            "$ref": "#/$defs/scalar"
          }
        },
        "widget": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*\\.dashboard\\.[a-z][a-z0-9_]*$"
        },
        "inline": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/row"
          },
          "maxItems": 200
        }
      },
      "description": "Fuente declarada de solo lectura: q | plan(+args) | widget | inline."
    },
    "source": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^data\\.[A-Za-z_][A-Za-z0-9_]{0,63}$"
        }
      ],
      "description": "Referencia a data.<nombre>."
    },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "blocks"
      ],
      "properties": {
        "kind": {
          "enum": [
            "modal",
            "drawer"
          ]
        },
        "title": {
          "$ref": "#/$defs/label"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          },
          "maxItems": 24,
          "minItems": 1
        }
      }
    },
    "block": {
      "x-genui": "block",
      "description": "Despachado por `type`; ver block_<type>.",
      "oneOf": [
        {
          "$ref": "#/$defs/block_stack"
        },
        {
          "$ref": "#/$defs/block_grid"
        },
        {
          "$ref": "#/$defs/block_tabs"
        },
        {
          "$ref": "#/$defs/block_section"
        },
        {
          "$ref": "#/$defs/block_text"
        },
        {
          "$ref": "#/$defs/block_markdown"
        },
        {
          "$ref": "#/$defs/block_alert"
        },
        {
          "$ref": "#/$defs/block_empty"
        },
        {
          "$ref": "#/$defs/block_card"
        },
        {
          "$ref": "#/$defs/block_list"
        },
        {
          "$ref": "#/$defs/block_kpi"
        },
        {
          "$ref": "#/$defs/block_stats"
        },
        {
          "$ref": "#/$defs/block_links"
        },
        {
          "$ref": "#/$defs/block_timeline"
        },
        {
          "$ref": "#/$defs/block_table"
        },
        {
          "$ref": "#/$defs/block_model_view"
        },
        {
          "$ref": "#/$defs/block_view"
        },
        {
          "$ref": "#/$defs/block_chart"
        },
        {
          "$ref": "#/$defs/block_form"
        },
        {
          "$ref": "#/$defs/block_wizard"
        },
        {
          "$ref": "#/$defs/block_confirm"
        },
        {
          "$ref": "#/$defs/block_settings"
        },
        {
          "$ref": "#/$defs/block_media"
        },
        {
          "$ref": "#/$defs/block_slot"
        },
        {
          "$ref": "#/$defs/block_ext"
        }
      ]
    },
    "block_stack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "blocks"
      ],
      "properties": {
        "type": {
          "const": "stack"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "when": {
          "$ref": "#/$defs/predicate"
        },
        "fallback": {
          "type": "string",
          "maxLength": 2000
        },
        "direction": {
          "enum": [
            "vertical",
            "horizontal"
          ]
        },
        "title": {
          "$ref": "#/$defs/label"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          },
          "maxItems": 24,
          "minItems": 1
        }
      }
    },
    "block_grid": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "blocks"
      ],
      "properties": {
        "type": {
          "const": "grid"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "when": {
          "$ref": "#/$defs/predicate"
        },
        "fallback": {
          "type": "string",
          "maxLength": 2000
        },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "title": {
          "$ref": "#/$defs/label"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          },
          "maxItems": 24,
          "minItems": 1
        }
      }
    },
    "block_tabs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "tabs"
      ],
      "properties": {
        "type": {
          "const": "tabs"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "when": {
          "$ref": "#/$defs/predicate"
        },
        "fallback": {
          "type": "string",
          "maxLength": 2000
        },
        "state": {
          "$ref": "#/$defs/bindingPath"
        },
        "tabs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "label",
              "blocks"
            ],
            "properties": {
              "key": {
                "$ref": "#/$defs/key"
              },
              "label": {
                "$ref": "#/$defs/label"
              },
              "blocks": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/block"
                },
                "maxItems": 24,
                "minItems": 1
              }
            }
          },
          "maxItems": 8,
          "minItems": 1
        }
      }
    },
    "block_section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "title",
        "blocks"
      ],
      "properties": {
        "type": {
          "const": "section"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "when": {
          "$ref": "#/$defs/predicate"
        },
        "fallback": {
          "type": "string",
          "maxLength": 2000
        },
        "title": {
          "$ref": "#/$defs/label"
        },
        "collapsible": {
          "type": "boolean"
        },
        "collapsed": {
          "type": "boolean"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          },
          "maxItems": 24,
          "minItems": 1
        }
      }
    },
    "block_text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "const": "text"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "when": {
          "$ref": "#/$defs/predicate"
        },
        "fallback": {
          "type": "string",
          "maxLength": 2000
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "tone": {
