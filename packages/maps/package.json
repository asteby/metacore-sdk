{
  "name": "@asteby/metacore-maps",
  "version": "0.2.2",
  "description": "Lazy maps for metacore hosts and addons — MapView, markers, clusters, routes, geofences, LocationPicker, TrackingTimeline and the declarative `map`/`timeline` renderers. MapLibre GL loads on demand; no API keys.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/asteby/metacore-sdk",
    "directory": "packages/maps"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    },
    "./view": {
      "types": "./dist/view.d.ts",
      "import": "./dist/view.js"
    },
    "./panel": {
      "types": "./dist/panel.d.ts",
      "import": "./dist/panel.js"
    },
    "./timeline-panel": {
      "types": "./dist/timeline-panel.d.ts",
      "import": "./dist/timeline-panel.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@asteby/storefront": "workspace:^"
  },
  "peerDependencies": {
    "@asteby/metacore-runtime-react": "workspace:^",
    "@asteby/metacore-sdk": "workspace:^",
    "maplibre-gl": ">=4",
    "pmtiles": ">=3",
    "react": ">=18",
    "react-dom": ">=18",
    "react-i18next": ">=13"
  },
  "peerDependenciesMeta": {
    "@asteby/metacore-runtime-react": {
      "optional": true
    },
    "@asteby/metacore-sdk": {
      "optional": true
    },
    "pmtiles": {
      "optional": true
    },
    "react-i18next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@asteby/metacore-runtime-react": "workspace:*",
    "@asteby/metacore-sdk": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.0",
    "happy-dom": "^20.11.2",
    "i18next": "^26.0.0",
    "maplibre-gl": "^6.14.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^17.0.0",
    "tsup": "^8.3.5",
    "typescript": "^6.0.0",
    "vitest": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
