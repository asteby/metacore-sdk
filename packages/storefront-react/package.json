{
  "name": "@asteby/storefront-react",
  "version": "0.8.0",
  "description": "React bindings for @asteby/storefront — SSR-safe provider, optimistic cart, Money, responsive Image, prices, variant selection, SEO meta and JSON-LD, section registry and server-rendered theme CSS.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/asteby/metacore-sdk",
    "directory": "packages/storefront-react"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./cart": {
      "import": {
        "types": "./dist/cart.d.ts",
        "default": "./dist/cart.js"
      },
      "require": {
        "types": "./dist/cart.d.cts",
        "default": "./dist/cart.cjs"
      }
    },
    "./cart.css": "./dist/cart.css",
    "./fitment": {
      "import": {
        "types": "./dist/fitment.d.ts",
        "default": "./dist/fitment.js"
      },
      "require": {
        "types": "./dist/fitment.d.cts",
        "default": "./dist/fitment.cjs"
      }
    },
    "./mockups": {
      "import": {
        "types": "./dist/mockups.d.ts",
        "default": "./dist/mockups.js"
      },
      "require": {
        "types": "./dist/mockups.d.cts",
        "default": "./dist/mockups.cjs"
      }
    },
    "./payments": {
      "import": {
        "types": "./dist/payments.d.ts",
        "default": "./dist/payments.js"
      },
      "require": {
        "types": "./dist/payments.d.cts",
        "default": "./dist/payments.cjs"
      }
    },
    "./promotions": {
      "import": {
        "types": "./dist/promotions.d.ts",
        "default": "./dist/promotions.js"
      },
      "require": {
        "types": "./dist/promotions.d.cts",
        "default": "./dist/promotions.cjs"
      }
    },
    "./ui": {
      "import": {
        "types": "./dist/ui.d.ts",
        "default": "./dist/ui.js"
      },
      "require": {
        "types": "./dist/ui.d.cts",
        "default": "./dist/ui.cjs"
      }
    },
    "./ui.css": "./dist/ui.css",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup && node scripts/copy-ui-css.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "@asteby/storefront": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "axe-core": "4.11.4",
    "happy-dom": "^20.11.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsup": "^8.3.5",
    "typescript": "^6.0.0",
    "vitest": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
