{
  "name": "@asteby/storefront",
  "version": "0.31.0",
  "description": "Typed client for the Storefront API v1 (catalog, cart, checkout, customer, content) using only global fetch — Node 20+, edge runtimes and browsers — plus an in-memory mock of the whole contract and, in `@asteby/storefront/fiscal-document`, a country-agnostic engine that reads a buyer's fiscal document (PDF) in the browser or Node.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/asteby/metacore-sdk",
    "directory": "packages/storefront"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./mock": {
      "import": {
        "types": "./dist/mock.d.ts",
        "default": "./dist/mock.js"
      },
      "require": {
        "types": "./dist/mock.d.cts",
        "default": "./dist/mock.cjs"
      }
    },
    "./geo": {
      "import": {
        "types": "./dist/geo.d.ts",
        "default": "./dist/geo.js"
      },
      "require": {
        "types": "./dist/geo.d.cts",
        "default": "./dist/geo.cjs"
      }
    },
    "./mockup": {
      "import": {
        "types": "./dist/mockup.d.ts",
        "default": "./dist/mockup.js"
      },
      "require": {
        "types": "./dist/mockup.d.cts",
        "default": "./dist/mockup.cjs"
      }
    },
    "./fiscal-document": {
      "import": {
        "types": "./dist/fiscal-document.d.ts",
        "default": "./dist/fiscal-document.js"
      },
      "require": {
        "types": "./dist/fiscal-document.d.cts",
        "default": "./dist/fiscal-document.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {},
  "peerDependencies": {
    "pdfjs-dist": ">=4.2.67",
    "jsqr": "^1.4.0"
  },
  "peerDependenciesMeta": {
    "pdfjs-dist": {
      "optional": true
    },
    "jsqr": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "jsqr": "^1.4.0",
    "pdfjs-dist": "^5.7.284",
    "tsup": "^8.3.5",
    "typescript": "^6.0.0",
    "vitest": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "storefront": "./dist/cli.js"
  }
}
